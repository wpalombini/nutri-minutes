# Copy to .env and adjust. Never commit real credentials.

# Postgres connection for migrations and workers (the local compose database by default).
DATABASE_URL=postgresql://pipeline:pipeline-local-only@127.0.0.1:5433/pipeline

# A separate, disposable database for tests. Tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql://pipeline:pipeline-local-only@127.0.0.1:5433/pipeline_test
