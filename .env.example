# Copy to .env and adjust. Never commit real credentials. On the production VM, replace every
# password with a long random value, such as the output of `openssl rand -hex 32`. Passwords go
# into connection URLs, so use letters and digits only.
# Docker Compose reads .env automatically. To use it from workers/ on the host, run:
#   set -a; . ../.env; set +a

# Postgres schema owner, used by the db service and migrations.
POSTGRES_PASSWORD=pipeline-local-only
# Login role the workers connect as (pipeline_runner, a member of pipeline_worker).
WORKER_DB_PASSWORD=worker-local-only
# Host port for the database, published on 127.0.0.1 only.
DB_HOST_PORT=5433

# Scout: a project contact address for the Europe PMC User-Agent, not a personal one. Required.
# The GitHub noreply address can't receive mail; switch to a routed project address once the
# domain is set up.
EUROPE_PMC_CONTACT=277190291+agent-wpalombini@users.noreply.github.com
# Optional Scout settings, shown with their defaults. Uncomment to change them.
# EUROPE_PMC_REQUEST_DELAY_SECONDS=1.0
# SCOUT_INITIAL_DAYS=30
# SCOUT_OVERLAP_DAYS=2
# SCOUT_MAX_RESUMES=3

# Host-side tools (tests, Alembic and Scout run from workers/ with uv).
DATABASE_URL=postgresql://pipeline:${POSTGRES_PASSWORD}@127.0.0.1:${DB_HOST_PORT}/pipeline
# A separate, disposable database for tests. Tests drop and recreate its schema.
TEST_DATABASE_URL=postgresql://pipeline:${POSTGRES_PASSWORD}@127.0.0.1:${DB_HOST_PORT}/pipeline_test
