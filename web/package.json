{
  "name": "research-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Nutri Minutes web app (Next.js App Router). Reads data only through the API (ADR 0003).",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tokens": "node scripts/tokens.ts",
    "tokens:check": "node scripts/tokens.ts --check",
    "check:bundle": "node scripts/check-client-bundle.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
